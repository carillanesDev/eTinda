// eTinda — Authoritative PostgreSQL Schema (AGENTS.md Section 6)
// Configured for Vercel Free Tier + Vercel Prisma Postgres Free Tier
// Rules:
// 1. Primary keys use UUIDs (@db.Uuid).
// 2. Monetary values use integer centavos (Int).
// 3. Product quantities & inventory movements use DECIMAL(12, 3) (@db.Decimal(12, 3)).
// 4. Timestamps use TIMESTAMPTZ (@db.Timestamptz(3)).
// 5. All business records are associated with a store (storeId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HELPER
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  UTANG
  PARTIAL_CASH_UTANG
}

enum PaymentType {
  SALE_CASH
  UTANG_PAYMENT
}

enum InventoryMovementType {
  SALE_DEDUCTION
  PURCHASE_RECEIPT
  STOCK_ADDITION
  STOCK_DEDUCTION
  STOCK_ADJUSTMENT
  SALE_VOID_REVERSAL
}

enum UtangLedgerEntryType {
  CHARGE
  PAYMENT
  ADJUSTMENT
}

enum SyncEventProcessingStatus {
  ACKNOWLEDGED
  CONFLICT
  REJECTED
}

// ============================================================================
// 1. STORE AND ACCESS
// ============================================================================

model Store {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  address       String
  contactNumber String   @map("contact_number")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users              User[]
  devices            Device[]
  categories         Category[]
  products           Product[]
  productVariants    ProductVariant[]
  purchaseRecords    PurchaseRecord[]
  purchaseItems      PurchaseItem[]
  sales              Sale[]
  saleItems          SaleItem[]
  payments           Payment[]
  customers          Customer[]
  utangAccounts      UtangAccount[]
  utangLedgerEntries UtangLedgerEntry[]
  inventoryMovements InventoryMovement[]
  syncEvents         SyncEventRecord[]
  syncCheckpoints    SyncCheckpoint[]
  auditLogs          AuditLog[]

  @@map("stores")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  name         String
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(HELPER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  registeredDevices  Device[]            @relation("DeviceRegisteredBy")
  sales              Sale[]              @relation("SaleOperator")
  voidedSales        Sale[]              @relation("SaleVoidedBy")
  payments           Payment[]
  purchaseRecords    PurchaseRecord[]
  inventoryMovements InventoryMovement[]
  utangLedgerEntries UtangLedgerEntry[]
  syncEvents         SyncEventRecord[]
  auditLogs          AuditLog[]
  sessions           Session[]
  accounts           Account[]

  @@index([storeId, role, isActive])
  @@map("users")
}

model Device {
  id                 String     @id @default(uuid()) @db.Uuid
  storeId            String     @map("store_id") @db.Uuid
  deviceName         String     @map("device_name")
  deviceType         DeviceType @default(TABLET) @map("device_type")
  registeredByUserId String     @map("registered_by_user_id") @db.Uuid
  isAuthorized       Boolean    @default(true) @map("is_authorized")
  revokedAt          DateTime?  @map("revoked_at") @db.Timestamptz(3)
  lastSyncAt         DateTime?  @map("last_sync_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  registeredBy       User                @relation("DeviceRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  sales              Sale[]
  payments           Payment[]
  purchaseRecords    PurchaseRecord[]
  inventoryMovements InventoryMovement[]
  utangLedgerEntries UtangLedgerEntry[]
  syncEvents         SyncEventRecord[]
  syncCheckpoint     SyncCheckpoint?
  auditLogs          AuditLog[]

  @@index([storeId, isAuthorized])
  @@map("devices")
}

// Auth.js / Session-related tables (AGENTS.md Section 6)
model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refreshToken      String?  @map("refresh_token")
  accessToken       String?  @map("access_token")
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type")
  scope             String?
  idToken           String?  @map("id_token")
  sessionState      String?  @map("session_state")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  deviceId     String?  @map("device_id") @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// 2. PRODUCT MANAGEMENT
// ============================================================================

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([storeId, name])
  @@index([storeId, sortOrder])
  @@map("categories")
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  storeId              String   @map("store_id") @db.Uuid
  categoryId           String   @map("category_id") @db.Uuid
  name                 String
  baseUnit             String   @map("base_unit")
  sellingPriceCentavos Int      @map("selling_price_centavos")
  latestCostCentavos   Int      @map("latest_cost_centavos")
  lowStockThreshold    Decimal  @map("low_stock_threshold") @db.Decimal(12, 3)
  allowDecimalQuantity Boolean  @default(false) @map("allow_decimal_quantity")
  isFrequent           Boolean  @default(false) @map("is_frequent")
  isActive             Boolean  @default(true) @map("is_active")
  cachedStock          Decimal  @default(0) @map("cached_stock") @db.Decimal(12, 3)
  hasOversellConflict  Boolean  @default(false) @map("has_oversell_conflict")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants           ProductVariant[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  inventoryMovements InventoryMovement[]

  @@unique([storeId, name])
  @@index([storeId, isActive, categoryId])
  @@index([storeId, updatedAt])
  @@map("products")
}

model ProductVariant {
  id                   String   @id @default(uuid()) @db.Uuid
  storeId              String   @map("store_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  name                 String
  unitLabel            String   @map("unit_label")
  conversionMultiplier Decimal  @map("conversion_multiplier") @db.Decimal(12, 3)
  sellingPriceCentavos Int      @map("selling_price_centavos")
  barcodeOrSku         String?  @map("barcode_or_sku")
  allowDecimalQuantity Boolean  @default(false) @map("allow_decimal_quantity")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, name])
  @@index([storeId, productId, isActive])
  @@map("product_variants")
}

// ============================================================================
// 3. PURCHASING
// ============================================================================

model PurchaseRecord {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  supplierName      String   @map("supplier_name")
  referenceNote     String?  @map("reference_note")
  totalCostCentavos Int      @map("total_cost_centavos")
  deviceId          String   @map("device_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  userNameSnapshot  String   @map("user_name_snapshot")
  syncEventId       String?  @unique @map("sync_event_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  device             Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              PurchaseItem[]
  inventoryMovements InventoryMovement[]

  @@index([storeId, createdAt(sort: Desc)])
  @@map("purchase_records")
}

model PurchaseItem {
  id                   String  @id @default(uuid()) @db.Uuid
  purchaseRecordId     String  @map("purchase_record_id") @db.Uuid
  storeId              String  @map("store_id") @db.Uuid
  productId            String  @map("product_id") @db.Uuid
  productNameSnapshot  String  @map("product_name_snapshot")
  quantityAdded        Decimal @map("quantity_added") @db.Decimal(12, 3)
  unitCostCentavos     Int     @map("unit_cost_centavos")
  subtotalCostCentavos Int     @map("subtotal_cost_centavos")

  purchaseRecord PurchaseRecord @relation(fields: [purchaseRecordId], references: [id], onDelete: Restrict)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseRecordId])
  @@index([storeId, productId])
  @@map("purchase_items")
}

// ============================================================================
// 4. SALES AND PAYMENTS
// ============================================================================

model Sale {
  id                   String        @id @default(uuid()) @db.Uuid
  storeId              String        @map("store_id") @db.Uuid
  receiptNumber        String        @map("receipt_number")
  status               SaleStatus    @default(COMPLETED)
  paymentMethod        PaymentMethod @map("payment_method")
  subtotalCentavos     Int           @map("subtotal_centavos")
  totalCentavos        Int           @map("total_centavos")
  cashTenderedCentavos Int           @map("cash_tendered_centavos")
  changeGivenCentavos  Int           @map("change_given_centavos")
  utangChargedCentavos Int           @map("utang_charged_centavos")
  customerId           String?       @map("customer_id") @db.Uuid
  customerNameSnapshot String?       @map("customer_name_snapshot")
  deviceId             String        @map("device_id") @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  userNameSnapshot     String        @map("user_name_snapshot")
  voidedAt             DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason           String?       @map("void_reason")
  voidedByUserId       String?       @map("voided_by_user_id") @db.Uuid
  syncEventId          String?       @unique @map("sync_event_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  device             Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user               User                @relation("SaleOperator", fields: [userId], references: [id], onDelete: Restrict)
  voidedBy           User?               @relation("SaleVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]
  utangLedgerEntries UtangLedgerEntry[]

  @@unique([storeId, receiptNumber])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([storeId, customerId, createdAt(sort: Desc)])
  @@map("sales")
}

model SaleItem {
  id                       String  @id @default(uuid()) @db.Uuid
  saleId                   String  @map("sale_id") @db.Uuid
  storeId                  String  @map("store_id") @db.Uuid
  productId                String  @map("product_id") @db.Uuid
  variantId                String? @map("variant_id") @db.Uuid
  productNameSnapshot      String  @map("product_name_snapshot")
  unitLabelSnapshot        String  @map("unit_label_snapshot")
  quantity                 Decimal @db.Decimal(12, 3)
  baseUnitMultiplier       Decimal @map("base_unit_multiplier") @db.Decimal(12, 3)
  unitSellingPriceCentavos Int     @map("unit_selling_price_centavos")
  unitCostSnapshotCentavos Int     @map("unit_cost_snapshot_centavos")
  subtotalCentavos         Int     @map("subtotal_centavos")

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  store   Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([storeId, productId])
  @@map("sale_items")
}

model Payment {
  id                   String      @id @default(uuid()) @db.Uuid
  storeId              String      @map("store_id") @db.Uuid
  saleId               String?     @map("sale_id") @db.Uuid
  customerId           String?     @map("customer_id") @db.Uuid
  customerNameSnapshot String?     @map("customer_name_snapshot")
  amountCentavos       Int         @map("amount_centavos")
  paymentType          PaymentType @map("payment_type")
  notes                String?
  deviceId             String      @map("device_id") @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  userNameSnapshot     String      @map("user_name_snapshot")
  syncEventId          String?     @unique @map("sync_event_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sale             Sale?             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  device           Device            @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  utangLedgerEntry UtangLedgerEntry?

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, customerId, createdAt(sort: Desc)])
  @@map("payments")
}

// ============================================================================
// 5. CUSTOMER CREDIT (UTANG)
// ============================================================================

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  name          String
  contactNumber String   @map("contact_number")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store              Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  utangAccount       UtangAccount?
  utangLedgerEntries UtangLedgerEntry[]
  sales              Sale[]
  payments           Payment[]

  @@index([storeId, name])
  @@index([storeId, contactNumber])
  @@map("customers")
}

model UtangAccount {
  id                    String   @id @default(uuid()) @db.Uuid
  storeId               String   @map("store_id") @db.Uuid
  customerId            String   @unique @map("customer_id") @db.Uuid
  customerNameSnapshot  String   @map("customer_name_snapshot")
  contactNumberSnapshot String   @map("contact_number_snapshot")
  cachedBalanceCentavos Int      @default(0) @map("cached_balance_centavos")
  needsReconciliation   Boolean  @default(false) @map("needs_reconciliation")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ledgerEntries UtangLedgerEntry[]

  @@unique([storeId, customerId])
  @@index([storeId, cachedBalanceCentavos(sort: Desc)])
  @@map("utang_accounts")
}

model UtangLedgerEntry {
  id                             String               @id @default(uuid()) @db.Uuid
  storeId                        String               @map("store_id") @db.Uuid
  utangAccountId                 String               @map("utang_account_id") @db.Uuid
  customerId                     String               @map("customer_id") @db.Uuid
  customerNameSnapshot           String               @map("customer_name_snapshot")
  entryType                      UtangLedgerEntryType @map("entry_type")
  signedAmountCentavos           Int                  @map("signed_amount_centavos")
  runningBalanceSnapshotCentavos Int                  @map("running_balance_snapshot_centavos")
  referenceSaleId                String?              @map("reference_sale_id") @db.Uuid
  referencePaymentId             String?              @unique @map("reference_payment_id") @db.Uuid
  reversalOfEntryId              String?              @map("reversal_of_entry_id") @db.Uuid
  notes                          String
  deviceId                       String               @map("device_id") @db.Uuid
  userId                         String               @map("user_id") @db.Uuid
  userNameSnapshot               String               @map("user_name_snapshot")
  syncEventId                    String?              @unique @map("sync_event_id") @db.Uuid
  createdAt                      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  store           Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  utangAccount    UtangAccount       @relation(fields: [utangAccountId], references: [id], onDelete: Restrict)
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale            Sale?              @relation(fields: [referenceSaleId], references: [id], onDelete: Restrict)
  payment         Payment?           @relation(fields: [referencePaymentId], references: [id], onDelete: Restrict)
  reversalOfEntry UtangLedgerEntry?  @relation("UtangLedgerReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversals       UtangLedgerEntry[] @relation("UtangLedgerReversal")
  device          Device             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([utangAccountId, createdAt(sort: Desc)])
  @@index([storeId, customerId, createdAt(sort: Desc)])
  @@map("utang_ledger")
}

// ============================================================================
// 6. INVENTORY MOVEMENTS (APPEND-ONLY LEDGER)
// ============================================================================

model InventoryMovement {
  id                   String                @id @default(uuid()) @db.Uuid
  storeId              String                @map("store_id") @db.Uuid
  productId            String                @map("product_id") @db.Uuid
  productNameSnapshot  String                @map("product_name_snapshot")
  variantId            String?               @map("variant_id") @db.Uuid
  movementType         InventoryMovementType @map("movement_type")
  quantityChange       Decimal               @map("quantity_change") @db.Decimal(12, 3)
  unitCostCentavos     Int?                  @map("unit_cost_centavos")
  reasonOrNotes        String                @map("reason_or_notes")
  deviceId             String                @map("device_id") @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  userNameSnapshot     String                @map("user_name_snapshot")
  saleId               String?               @map("sale_id") @db.Uuid
  purchaseRecordId     String?               @map("purchase_record_id") @db.Uuid
  reversalOfMovementId String?               @map("reversal_of_movement_id") @db.Uuid
  conflictNote         String?               @map("conflict_note")
  syncEventId          String?               @map("sync_event_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant            ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  device             Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  sale               Sale?               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  purchaseRecord     PurchaseRecord?     @relation(fields: [purchaseRecordId], references: [id], onDelete: Restrict)
  reversalOfMovement InventoryMovement?  @relation("MovementReversal", fields: [reversalOfMovementId], references: [id], onDelete: Restrict)
  reversals          InventoryMovement[] @relation("MovementReversal")

  @@index([storeId, productId, createdAt(sort: Desc)])
  @@index([saleId])
  @@index([purchaseRecordId])
  @@map("inventory_movements")
}

// ============================================================================
// 7. SYNCHRONIZATION & AUDITING
// ============================================================================

model SyncEventRecord {
  eventId        String                    @id @map("event_id") @db.Uuid
  sequenceNumber BigInt                    @unique @default(autoincrement()) @map("sequence_number")
  storeId        String                    @map("store_id") @db.Uuid
  deviceId       String                    @map("device_id") @db.Uuid
  userId         String                    @map("user_id") @db.Uuid
  eventType      String                    @map("event_type")
  entityId       String                    @map("entity_id") @db.Uuid
  schemaVersion  Int                       @default(1) @map("schema_version")
  payload        Json
  status         SyncEventProcessingStatus @default(ACKNOWLEDGED)
  conflictReason String?                   @map("conflict_reason")
  clientCreatedAt DateTime                 @map("client_created_at") @db.Timestamptz(3)
  acknowledgedAt DateTime                  @default(now()) @map("acknowledged_at") @db.Timestamptz(3)

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([storeId, sequenceNumber(sort: Asc)])
  @@index([storeId, deviceId, acknowledgedAt(sort: Desc)])
  @@map("sync_events")
}

model SyncCheckpoint {
  id                 String   @id @default(uuid()) @db.Uuid
  storeId            String   @map("store_id") @db.Uuid
  deviceId           String   @unique @map("device_id") @db.Uuid
  lastSequenceNumber BigInt   @default(0) @map("last_sequence_number")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([storeId, deviceId])
  @@map("sync_checkpoints")
}

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  deviceId         String   @map("device_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  userNameSnapshot String   @map("user_name_snapshot")
  userRole         UserRole @map("user_role")
  action           String
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id") @db.Uuid
  summary          String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, entityType, entityId])
  @@map("audit_logs")
}

